<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Background -->
    <item android:drawable="@drawable/fallback_logo_gradient" />

    <!-- Subtle glow in the center -->
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60dp"
                android:startColor="#1AFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Sleek TV Icon -->
    <item
        android:drawable="@drawable/ic_tv_fallback"
        android:gravity="center"
        android:width="48dp"
        android:height="48dp" />
</layer-list>