<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:gravity="center"
    android:padding="50dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Roarzone Plugin"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btn_refresh_roarzone"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="Refresh Roarzone Channels"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/button_background_selector"
        android:stateListAnimator="@animator/button_focus_animator" />

    <ProgressBar
        android:id="@+id/pb_roarzone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_roarzone_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Roarzone provides local ISP TV channels."
        android:textColor="#88FFFFFF"
        android:textSize="18sp"
        android:gravity="center" />

</LinearLayout>